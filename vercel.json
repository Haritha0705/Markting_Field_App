{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "apps/client",
      "framework": "nextjs"
    },
    "server": {
      "root": "apps/server",
      "framework": "nestjs"
    }
  },
  "rewrites": [
    {
      "source": "/app/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/uploads/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
